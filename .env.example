# API key từ Visual Crossing (https://www.visualcrossing.com/weather-api)
CW_API=your_visual_crossing_api_key_here

# Cấu hình Redis Server
REDIS_HOST=localhost
REDIS_PORT=6379

# Thời gian sống của Cache (tính theo giây, mặc định 12 giờ = 43200s)
CACHE_TTL=43200

# Cổng khởi chạy ứng dụng Flask
APP_PORT=5002

